# Clerk publishable key (optional — omit to run in instant guest shortener mode)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend API URL (optional — defaults to "/api" via Vite dev proxy)
# VITE_API_URL=http://localhost:5000/api

# Set to "true" during automated E2E / load / manual testing to unlock all UI limits
# and allow simulated auth via ?testUser=<id> without Clerk OTP/CAPTCHA.
# NEVER set to "true" in production!
VITE_TESTING_MODE=false


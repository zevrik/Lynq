PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Redis Cloud Credentials (or local Redis instance)
REDIS_HOST=your_redis_host
REDIS_PORT=12599
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

# Application Settings
SHORT_CODE_LENGTH=6

# PostgreSQL Database URL (e.g., Neon serverless Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk Authentication (JWT session verification & user dashboard features)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# AI Configuration (Google Gemini 2.5 Flash for suggestions, summaries & phishing checks)
GEMINI_API_KEY=your_gemini_api_key

# Testing Mode (set to true only during local/automated testing to bypass rate limits & quotas)
TESTING_MODE=false



